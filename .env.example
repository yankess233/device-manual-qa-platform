# ============================================================
# 企业级设备手册智能问答平台 - 环境变量模板
# 用法：cp .env.example knowledge/.env  然后填写真实值
# 注意：knowledge/.env 已被 .gitignore 忽略，不要提交真实密钥
# ============================================================

# ---------- 大模型（OpenAI 兼容接口，默认阿里云百炼） ----------
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 部分客户端读取的是 DASHSCOPE_API_KEY，两者保持一致即可
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 文本大模型 / 视觉大模型 / 商品名抽取模型
# qwen3 系列默认开启思考模式（单次 20s+），在线问答请关闭；留空表示不下发该参数
LLM_DEFAULT_MODEL=qwen3.8-flash
LLM_ENABLE_THINKING=false
MODEL=qwen3.8-flash
VL_MODEL=qwen3-vl-plus
ITEM_MODEL=qwen3.8-flash

# ---------- 向量与重排模型 ----------
# BGE-M3 本地权重路径
BGE_M3_PATH=/models/bge-m3
# bge-reranker-large 本地权重路径
BGE_RERANKER_LARGE=/models/bge-reranker-large
# cuda:0 / cpu
BGE_DEVICE=cuda:0
BGE_FP16=true
EMBEDDING_DIM=1024

# ---------- Milvus ----------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_name
ENTITY_NAME_COLLECTION=kb_entity_name

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files

# ---------- MongoDB ----------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowledge

# ---------- MCP 联网搜索（阿里云百炼） ----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/web-search/mcp

# ---------- 查询流程参数（可选） ----------
MAX_CONTEXT_CHARS=12000
RRF_K=60
RRF_MAX_RESULTS=10
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_ABS=0.15
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=5
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.6
ITEM_NAME_MAX_OPTIONS=5
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5
ITEM_NAME_GAP_ABS=0.15