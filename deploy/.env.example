# ============================================================
# 部署环境变量（docker compose 与容器内应用共用这一份）
# 复制为 .env 后按实际情况修改：
#   cp .env.example .env
# 注意：.env 不进版本库（见仓库根 .gitignore）
# ============================================================

# ---------- 宿主机路径 ----------
# 数据卷落盘目录（etcd / milvus / minio / mongodb 都在它下面）
DOCKER_VOLUME_DIRECTORY=/opt/shoper-brain/volumes
# 模型权重目录，宿主机上要有 bge-m3/ 与 bge-reranker-large/ 两个子目录
# 容器内固定挂到 /models:ro
MODEL_DIR=/opt/shoper-brain/models

# ---------- 端口映射（宿主机端口） ----------
IMPORT_PORT=8000
QUERY_PORT=8001
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MONGO_PORT=27017
ATTU_PORT=7000

# ---------- 镜像 ----------
# 应用镜像 tag（改代码后重 build 建议同步升 tag，避免 compose 复用旧镜像）
APP_IMAGE_TAG=0.1
# 1=装 MinerU（导入 PDF 需要）；0=不装（只跑问答服务时可用，镜像小很多）
WITH_MINERU=1

# ---------- MinIO ----------
# 容器间用服务名 minio:9000 访问；这里只放凭据
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files

# ---------- MongoDB ----------
# 容器内由 compose 覆盖为 mongodb://mongodb:27017，这里不用改
MONGO_DB_NAME=knowledge

# ---------- 大模型（DashScope OpenAI 兼容接口） ----------
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL=qwen3.8-flash
LLM_DEFAULT_MODEL=qwen3.8-flash
ITEM_MODEL=qwen3.8-flash
VL_MODEL=qwen3-vl-plus
# qwen3 系列默认开思考（单次 20s+），在线问答必须关；留空表示不下发该参数
LLM_ENABLE_THINKING=false

# ---------- 向量与重排 ----------
# 下面两行由 compose 固定为 /models/...；只有在容器外直跑服务时才需要取消注释
# BGE_M3_PATH=/opt/shoper-brain/models/bge-m3
# BGE_RERANKER_LARGE=/opt/shoper-brain/models/bge-reranker-large
# 同理，容器内由 compose 覆盖成服务名，本地直跑时按需取消注释
# MILVUS_URL=http://192.168.10.150:19530
# MINIO_ENDPOINT=192.168.10.150:9000
# MONGO_URL=mongodb://192.168.10.150:27017
# 这里只配设备
# CPU 部署：BGE_DEVICE=cpu、BGE_FP16=false；有 GPU 时改成 cuda:0 / true
BGE_DEVICE=cpu
BGE_FP16=false
EMBEDDING_DIM=1024

# ---------- Milvus ----------
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1

# ---------- 检索参数（可选，留空用代码默认值） ----------
MAX_CONTEXT_CHARS=12000
RRF_K=60
RRF_MAX_RESULTS=10
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_ABS=0.15
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=5
RETRIEVAL_MODE=hybrid
EMBEDDING_DENSE_WEIGHT=0.5
EMBEDDING_SPARSE_WEIGHT=0.5
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.6
ITEM_NAME_MAX_OPTIONS=5
ITEM_NAME_GAP_ABS=0.15

# ---------- 接口安全 ----------
# 逗号分隔的 API Key 列表；留空 = 不鉴权（仅本地开发）。配置后：
#   接口需带 X-API-Key 头，或 ?key=xxx（EventSource 场景）
API_KEYS=
# CORS 白名单，逗号分隔；不要写 *
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001
# 上传限制
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_SUFFIXES=.pdf,.md,.markdown
